@inproceedings{jangir2026robotarena,
  abbr={ICLR},
  title={RobotArena $\infty$: Scalable Robot Benchmarking via Real-to-Sim Translation},
  author={Jangir, Yash and Zhang, Yidi and Yamazaki, Kashu and Zhang, Chenyu and Tu, Kuan-Hsun and Ke, Tsung-Wei and Ke, Lei and Bisk, Yonatan and Fragkiadaki, Katerina},
  booktitle={International Conference on Learning Representations (ICLR)},
  year={2026},
  eprint={2510.23571},
  url={https://arxiv.org/abs/2510.23571},
  html={https://robotarenainf.github.io/},
  abstract={RobotArena infinity shifts vision-language-action policy evaluation into large-scale simulated environments built automatically from real robot video. The pipeline converts demonstrations from widely used robot datasets into physics-consistent simulated counterparts using vision-language models, 2D-to-3D generative modeling and differentiable rendering, requiring only a single RGB image from a static-camera demonstration. Policies are scored by both VLM-guided automatic evaluation and scalable human preference judgments.},
  preview={RobotArena.png},
  selected={true},
}

